# Supabase Postgres connection string (Session pooler or direct connection)
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Telegram bot token, from @BotFather
TELEGRAM_BOT_TOKEN=

# Anthropic
ANTHROPIC_API_KEY=

# App
PORT=3000
# IANA timezone the caregivers are in (used to resolve "8am" etc. and to
# compute "today"'s day boundary correctly)
APP_TIMEZONE=Asia/Jakarta

# Max messages per caregiver per rolling 60s window before the bot asks them to slow down
RATE_LIMIT_PER_MINUTE=10

# Inactivity nudge threshold, hours
NUDGE_THRESHOLD_HOURS=6
# Daily digest send time, 24h HH:mm, server local time
DIGEST_TIME=20:00
