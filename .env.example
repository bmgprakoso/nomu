# Supabase Postgres connection string (Session pooler or direct connection)
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Meta WhatsApp Cloud API (test number)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=nomu-verify-me

# Anthropic
ANTHROPIC_API_KEY=

# App
PORT=3000

# Inactivity nudge threshold, hours
NUDGE_THRESHOLD_HOURS=6
# Daily digest send time, 24h HH:mm, server local time
DIGEST_TIME=20:00
